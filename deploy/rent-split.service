# LEGACY — systemd unit for Rent Split on server1 (tms.maxkendall.com).
#
# Production now runs via Docker Compose (see docker-compose.prod.yml,
# deploy/remote-deploy.sh, and deploy/CUTOVER.md). Do not install this unit on
# new hosts. The deploy script stops and disables rent-split.service on cutover.
#
# Kept in-tree only as a rollback reference:
#   sudo cp deploy/rent-split.service /etc/systemd/system/rent-split.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rent-split
#
# Env file (chmod 600), e.g.:
#   PORT=8080
#   DATA_DIR=/opt/rent-split-site/data
#
# Logs (legacy): journalctl -u rent-split -f
# Logs (current): docker compose -f /opt/rent-split-site/docker-compose.prod.yml logs -f

[Unit]
Description=Rent Split (tms.maxkendall.com) [LEGACY]
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rent-split-site
ExecStart=/opt/rent-split-site/server/.venv/bin/rent-split
Restart=on-failure
RestartSec=3

User=rent-split
Group=rent-split

EnvironmentFile=/etc/rent-split.env
Environment=PUBLIC_DIR=/opt/rent-split-site/frontend/dist
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rent-split-site/data

[Install]
WantedBy=multi-user.target
