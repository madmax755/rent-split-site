# systemd unit for Rent Split on server1 (tms.maxkendall.com).
#
# Install / refresh:
#   sudo cp deploy/rent-split.service /etc/systemd/system/rent-split.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rent-split
#
# Credentials live in a root-only env file (chmod 600), e.g.:
#   PORT=8080
#   DATA_DIR=/opt/rent-split-site/data
#   SECURE_COOKIE=1
#   RENT_SPLIT_ADMIN_USER=asoni
#   RENT_SPLIT_ADMIN_PASSWORD=...
#   RENT_SPLIT_SECRET=...
#
# Logs: journalctl -u rent-split -f

[Unit]
Description=Rent Split (tms.maxkendall.com)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rent-split-site
ExecStart=/opt/rent-split-site/server/.venv/bin/rent-split
Restart=on-failure
RestartSec=3

User=rent-split
Group=rent-split

EnvironmentFile=/etc/rent-split.env
Environment=PUBLIC_DIR=/opt/rent-split-site/frontend/dist
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rent-split-site/data

[Install]
WantedBy=multi-user.target
