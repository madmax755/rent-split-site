# Copy to .env for local dev, or maintain /etc/rent-split.env on server1
# (chmod 600). Never commit real secrets.
#
# Production (Docker Compose) overrides PORT / DATA_DIR / PUBLIC_DIR inside the
# container; keep secrets + SECURE_COOKIE here. See docker-compose.prod.yml.

# HTTP port the FastAPI server listens on.
PORT=8080

# Seeded into SQLite if the account table is empty (skipped when accounts.json is imported).
RENT_SPLIT_ADMIN_USER=asoni
RENT_SPLIT_ADMIN_PASSWORD=iamgay

# Random string used to sign session cookies. If unset, one is generated
# and persisted under DATA_DIR/.secret so restarts don't log everyone out.
RENT_SPLIT_SECRET=

# Where rent-split.db, backups/, and optional legacy JSON live.
# Local default: ./data at the repo root.
# server1 host path (bind-mounted): /opt/rent-split-site/data
# Inside the production container: /data (set by compose).
DATA_DIR=

# Set to 1 when serving over https so the session cookie gets the Secure flag.
SECURE_COOKIE=0

# Directory of built frontend assets (defaults to ../frontend/dist from server/).
# Production image sets PUBLIC_DIR=/app/public.
PUBLIC_DIR=
